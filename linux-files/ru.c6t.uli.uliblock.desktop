[Desktop Entry]
Name=UliBlock
# Change the path to match where you install the app.
Exec=/opt/UliBlock/uliblock %U
Terminal=false
Type=Application
Icon=ru.c6t.uli.uliblock
StartupWMClass=uliblock
Comment=UliBlock is a lightweight Scratch/TurboWarp editor with community extension gallery and offline cache.
MimeType=application/x.scratch.sb3;application/x.scratch.sb2;application/x.scratch.sb;
Categories=Development;
Keywords=scratch;turbowarp;uliblock;
